# Sourced by the career-ops cron entries (see automation/README.md). Kept in the
# repo rather than ~/.bashrc so the scheduled jobs do not depend on an
# interactive login shell.
#
# Every line here runs with a deliberately MINIMAL environment, which is how
# cron and systemd invoke things. Three consequences, all handled here:
#   1. `node` is an nvm install and is NOT on the default PATH.
#   2. Chromium's runtime libs (libnss3/libnspr4/libasound) were extracted
#      without root into ~/.local/share/playwright-libs, because this machine
#      has no passwordless sudo. Only needed by browser-tier commands
#      (check-liveness, browser-extract), not by the plain scan.
#   3. `opencode`, which career-triage shells out to, is a pnpm global install
#      rather than an nvm one, so it needs its own directory.
#
# The `career-*` wrappers in this directory each re-derive the repo root from
# their own path, so CAREER_OPS_REPO is not needed by them; it stays exported
# for anything else that wants to reach the repo from a cron shell.
export PATH="$HOME/.local/bin:$HOME/.local/share/pnpm/bin:$(ls -1d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1):/usr/bin:/bin"
export CAREER_OPS_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -d "$HOME/.local/share/playwright-libs" ] && \
  export LD_LIBRARY_PATH="$HOME/.local/share/playwright-libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
